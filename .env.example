# 服务监听端口 (默认 3000)
PORT=3000

# Telegram 机器人配置 (在 @BotFather 申请)
TELEGRAM_BOT_TOKEN=

# Telegram 接收预警的目标 Chat ID (可通过 @userinfobot 获取个人 ID 或群组 ID)
TELEGRAM_CHAT_ID=

# GMGN API Key (可选，前往 https://gmgn.ai/ai 免费申请，未填写则使用内置高胜率种子池)
GMGN_API_KEY=

# 模拟买入单笔金额 (USD，默认 10)
AUTO_BUY_AMOUNT=10

# 模拟买入总开关 (true / false)
AUTO_BUY_ENABLED=true

# 监控轮询间隔时间 (毫秒，默认 8000)
MONITOR_INTERVAL_MS=8000

# 实时持仓价格刷新间隔 (毫秒，默认 5000)
PRICE_UPDATE_INTERVAL_MS=5000
